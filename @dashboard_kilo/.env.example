# Variables de entorno para el dashboard de análisis de commodities

# Clave de API de Google Gemini para análisis avanzado (opcional)
GOOGLE_API_KEY=your_google_api_key_here

# Configuración de commodities por defecto (separados por coma)
DEFAULT_COMMODITIES=ZS=F,ZC=F,ZW=F,USDARS=X

# Período de análisis histórico por defecto
DEFAULT_PERIOD=6mo

# Intervalo de datos por defecto
DEFAULT_INTERVAL=1d