# Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y completa con tus configuraciones reales

# Configuración de la aplicación
APP_NAME=Dashboard de Commodities Agrícolas
APP_VERSION=1.0.0
DEBUG=False

# Configuración de Yahoo Finance
# No requiere API key, pero puedes configurar opciones adicionales
YFINANCE_TIMEOUT=30
YFINANCE_MAX_RETRIES=3

# Configuración de caché de Streamlit (en minutos)
CACHE_TTL=60

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE=dashboard.log

# Configuración regional
TIMEZONE=America/Argentina/Buenos_Aires
LOCALE=es_AR

# APIs adicionales (opcional - para funcionalidades futuras)
# API Key para datos meteorológicos (opcional)
WEATHER_API_KEY=tu_weather_api_key_aqui

# API Key para noticias financieras (opcional)
NEWS_API_KEY=tu_news_api_key_aqui

# API Key para análisis de sentimientos (opcional)
SENTIMENT_API_KEY=tu_sentiment_api_key_aqui