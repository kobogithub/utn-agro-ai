# Gemini Spatial Understanding 2D - Configuración de Entorno
# Copia este archivo como .env y configura tus valores

# Google AI API Key - Requerido
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
# DEBUG: Máximo detalle, INFO: Normal, WARNING: Solo advertencias, ERROR: Solo errores
LOG_LEVEL=INFO

# Configuración opcional del modelo (se puede cambiar en el script)
# GEMINI_MODEL=gemini-2.5-flash-preview-04-17

# Directorio de salida para imágenes procesadas (opcional)
# OUTPUT_DIR=output